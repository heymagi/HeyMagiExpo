# Copy to `.env` and fill in. `.env` is git-ignored and must stay that way.
#
# Only the two EXPO_PUBLIC_ values are needed to RUN the app -- Expo inlines them into the
# bundle and the anon key is public by design; RLS is what protects the data.
#
# The three below them are server-side only. They are already set as secrets on Supabase
# (that is how the deployed function reads them), so you only need them here for
# `npm run embed:intents` and `npm run smoke:llm`.

EXPO_PUBLIC_SUPABASE_URL=https://ozyxbdefhwoejejgyshm.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_URL=https://ozyxbdefhwoejejgyshm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
MAGI_LLM_PROVIDER=openai
OPENAI_API_KEY=
